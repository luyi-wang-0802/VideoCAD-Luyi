{
  "default_params": {
    "model_name": "primitive_action_policy",
    "dataset_path": "processed_data",
    "action_vocab_path": "processed_data/action_vocab.json",
    "hidden_size": 384,
    "image_channels": 1,
    "history_length": 32,
    "num_transformer_layers": 6,
    "num_attention_heads": 6,
    "dim_feedforward": 1024,
    "dropout": 0.0,
    "max_step_index": 512,
    "max_repeat_count": 8,
    "use_binned_primitive_params": false,
    "primitive_param_dim": 5,
    "entity_feature_dim": 11,
    "num_param_bins": 1000,
    "key_bin_size": 50,
    "repeat_bin_size": 100,
    "model_coord_min": -0.5,
    "model_coord_max": 0.5,
    "soft_xy_bin_loss": true,
    "xy_bin_tolerance": 5,
    "xy_bin_soft_sigma": 2.0,
    "ignore_interval_bin_loss": true,
    "ignore_interval_loss": true,
    "default_key_interval_ms": 100.0,
    "xy_smooth_l1_beta": 0.02,
    "loss_action_type_weight": 3.0,
    "loss_high_level_weight": 1.0,
    "loss_gui_action_weight": 1.0,
    "loss_param_bins_weight": 1.0,
    "loss_xy_weight": 50.0,
    "loss_key_weight": 1.0,
    "loss_repeat_weight": 0.5,
    "loss_interval_weight": 0.0,
    "loss_target_entity_weight": 1.0,
    "loss_point_role_weight": 1.0,
    "train_config": {
      "lr": 0.0003,
      "lr_scheduler": "cosine",
      "min_lr": 0.000001,
      "log_frequency": 10,
      "val_frequency": 5,
      "early_stopping_enabled": true,
      "early_stopping_patience": 20,
      "early_stopping_min_delta": 0.0,
      "early_stopping_metric": "loss",
      "early_stopping_mode": "min"
    }
  }
}
