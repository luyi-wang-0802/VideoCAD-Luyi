{
  "default_params": {
    "model_name": "structured_primitive_action_policy",
    "dataset_path": "processed_data",
    "action_vocab_path": "processed_data/action_vocab.json",
    "hidden_size": 384,
    "history_length": 32,
    "max_wall_tokens": 256,
    "max_insertion_tokens": 64,
    "num_transformer_layers": 6,
    "num_attention_heads": 6,
    "dim_feedforward": 1024,
    "dropout": 0.0,
    "max_step_index": 512,
    "max_repeat_count": 8,
    "ignore_interval_loss": true,
    "default_key_interval_ms": 100.0,
    "xy_output_activation": "sigmoid",
    "xy_smooth_l1_beta": 0.02,
    "loss_action_type_weight": 3.0,
    "loss_high_level_weight": 2.0,
    "loss_gui_action_weight": 2.0,
    "loss_xy_weight": 200.0,
    "loss_aux_wall_weight": 1.0,
    "loss_aux_point_role_weight": 1.0,
    "loss_key_weight": 1.0,
    "loss_repeat_weight": 0.5,
    "loss_interval_weight": 0.0,
    "train_config": {
      "lr": 0.0003,
      "lr_scheduler": "cosine",
      "min_lr": 0.000001,
      "log_frequency": 10,
      "val_frequency": 5,
      "early_stopping_enabled": true,
      "early_stopping_patience": 20,
      "early_stopping_min_delta": 0.0,
      "early_stopping_metric": "xy_mae",
      "early_stopping_mode": "min"
    }
  }
}
